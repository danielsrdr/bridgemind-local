{
  "name": "bridgemind-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-agent workspace for Claude Code (and local LLMs)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "hub": "node hub/index.ts",
    "build": "vite build && npm run build:hub",
    "build:hub": "esbuild hub/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=build/hub.mjs --external:@lydell/node-pty --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "app": "npm run build && electron .",
    "app:dev": "electron .",
    "package": "npm run build && electron-packager . BridgeMind --platform=win32 --arch=x64 --icon=electron/icon.ico --out=release --overwrite --no-asar --app-version=0.2.0 --win32metadata.ProductName=BridgeMind --win32metadata.FileDescription=BridgeMind --ignore=\"^/(web|hub|scripts|docs|out|release)(/|$)\" --ignore=\"^/node_modules/(?!@lydell|uiohook-napi|node-gyp-build)\" --prune=false --ignore=\"^/(tsconfig.json|vite.config.ts|CLAUDE.md|.gitignore)$\"",
    "install": "npm run package && powershell -ExecutionPolicy Bypass -File scripts/install-app.ps1",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "icon": "node scripts/make-icon.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "croner": "^10.0.1",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force": "^3.0.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "main": "electron/main.cjs"
}
