{
  "name": "bridgemind-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-agent workspace for Claude Code (and local LLMs)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "hub": "node hub/index.ts",
    "build": "vite build",
    "start": "npm run build && node hub/index.ts --open",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "croner": "^10.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
